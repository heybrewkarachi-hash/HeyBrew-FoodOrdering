NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/heybrew
# Optional — omit for local IN_MEMORY_FALLBACK rate limits / sessions / idempotency / socket adapter
REDIS_URL=

CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

COOKIE_SECRET=change-me-cookie-secret-min-16
CSRF_SECRET=change-me-csrf-secret-min-16
ADMIN_COOKIE_NAME=heybrew_admin_session

# Exact CORS allowlist (comma-separated). CLIENT_URL and ADMIN_URL are always included.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false

# Cloudinary — leave unset until configured; signed-upload endpoint returns CLOUDINARY_NOT_CONFIGURED
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=heybrew

# Required for `npm run seed` — no default password in code
ADMIN_EMAIL=owner@heybrew.local
ADMIN_PASSWORD=change-me-strong-password

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
